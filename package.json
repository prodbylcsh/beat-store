{
  "name": "beat-store",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n web,api \"vite\" \"wrangler dev --port 8787\"",
    "dev:web": "vite",
    "dev:api": "wrangler dev --port 8787",
    "build": "vue-tsc --noEmit -p tsconfig.json && vite build",
    "preview": "npm run build && wrangler dev --port 8787",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.worker.json",
    "test": "vitest run",
    "db:local": "wrangler d1 migrations apply DB --local",
    "db:test": "wrangler d1 migrations apply DB --remote --config wrangler.test.jsonc",
    "db:prod": "wrangler d1 migrations apply DB --remote",
    "seed:demo": "node scripts/seed-demo.mjs",
    "deploy:test": "npm run build && wrangler deploy --config wrangler.test.jsonc",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "@breezystack/lamejs": "^1.2.7",
    "@fontsource-variable/archivo": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "vue": "^3.5.45",
    "vue-router": "^5.5.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261112.1",
    "@vitejs/plugin-vue": "^6.0.11",
    "concurrently": "^10.0.7",
    "typescript": "^6.0.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.0",
    "vue-tsc": "^3.3.14",
    "wrangler": "^4.161.0"
  }
}

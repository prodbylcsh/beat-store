{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler",
    "strict": true, "skipLibCheck": true, "noEmit": true,
    "lib": ["ES2022"], "types": ["@cloudflare/workers-types"], "isolatedModules": true,
    "noUnusedLocals": true
  },
  "include": ["src/worker/**/*", "src/shared/**/*"]
}
